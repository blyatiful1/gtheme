<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata: this is what an app store shows about gtheme.
     Validate with `appstreamcli validate` before every release.
     The screenshot URLs point at real PNGs committed under
     docs/media/screenshots/ — they are produced by the page-walk test, so a
     release can never ship a picture of a window that does not exist. -->
<component type="desktop-application">
  <id>io.github.blyatiful1.Gtheme</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <name>Gtheme</name>
  <summary>Change how your desktop looks — safely</summary>
  <!-- The app's own text is English only for now; the store listing's one-line
       summary and the words people search by are not, because those are data
       and need no translation machinery behind them. The wording matches
       Comment[xx] and Keywords[xx] in the .desktop file. -->
  <summary xml:lang="de">Das Aussehen des Desktops ändern — sicher</summary>
  <summary xml:lang="pt_BR">Mude a aparência da sua área de trabalho — com segurança</summary>
  <summary xml:lang="es">Cambia el aspecto de tu escritorio — de forma segura</summary>
  <summary xml:lang="fr">Changez l'apparence de votre bureau — en toute sécurité</summary>

  <description>
    <p>
      Gtheme puts your wallpaper, colours, icons, fonts, top bar and add-ons in
      one window, in plain language, with a picture of what each thing does.
    </p>
    <p>
      Before it changes anything, it saves how your desktop looked. If you do
      not like a change, one click puts it back.
    </p>
    <p>
      Looks only change settings. They can't run programs on your computer.
    </p>
    <p>What you can change:</p>
    <ul>
      <li>Pick a whole look at once, or change one piece at a time</li>
      <li>The picture behind everything, from your photos or the ones included</li>
      <li>Light or dark, and the highlight colour</li>
      <li>App icons, the mouse pointer, and how big text is</li>
      <li>The bar across the top, window buttons, and desktops</li>
      <li>Extra features you can switch on, found and installed for you</li>
      <li>Go back to how it was, at any point, from a list with dates</li>
    </ul>
  </description>

  <launchable type="desktop-id">io.github.blyatiful1.Gtheme.desktop</launchable>
  <provides>
    <binary>gtheme</binary>
  </provides>

  <categories>
    <category>Settings</category>
    <category>DesktopSettings</category>
  </categories>

  <keywords>
    <keyword>theme</keyword>
    <keyword>wallpaper</keyword>
    <keyword>appearance</keyword>
    <keyword>add-ons</keyword>
    <keyword xml:lang="de">Thema</keyword>
    <keyword xml:lang="de">Hintergrundbild</keyword>
    <keyword xml:lang="de">Erscheinungsbild</keyword>
    <keyword xml:lang="de">Erweiterungen</keyword>
    <keyword xml:lang="pt_BR">tema</keyword>
    <keyword xml:lang="pt_BR">papel de parede</keyword>
    <keyword xml:lang="pt_BR">aparência</keyword>
    <keyword xml:lang="pt_BR">extensões</keyword>
    <keyword xml:lang="es">tema</keyword>
    <keyword xml:lang="es">fondo de pantalla</keyword>
    <keyword xml:lang="es">apariencia</keyword>
    <keyword xml:lang="es">extensiones</keyword>
    <keyword xml:lang="fr">thème</keyword>
    <keyword xml:lang="fr">fond d'écran</keyword>
    <keyword xml:lang="fr">apparence</keyword>
    <keyword xml:lang="fr">extensions</keyword>
  </keywords>

  <screenshots>
    <screenshot type="default">
      <caption>How your desktop looks right now, on one page</caption>
      <image type="source" width="1200" height="900">https://raw.githubusercontent.com/blyatiful1/gtheme/main/docs/media/screenshots/home-light.png</image>
    </screenshot>
    <screenshot>
      <caption>Whole looks: one click changes everything, and one click puts it back</caption>
      <image type="source" width="1200" height="900">https://raw.githubusercontent.com/blyatiful1/gtheme/main/docs/media/screenshots/looks-light.png</image>
    </screenshot>
    <screenshot>
      <caption>The picture behind everything, with a preview before you keep it</caption>
      <image type="source" width="1200" height="900">https://raw.githubusercontent.com/blyatiful1/gtheme/main/docs/media/screenshots/wallpaper-light.png</image>
    </screenshot>
    <screenshot>
      <caption>Light or dark, and the highlight colour</caption>
      <image type="source" width="1200" height="900">https://raw.githubusercontent.com/blyatiful1/gtheme/main/docs/media/screenshots/colors-dark.png</image>
    </screenshot>
    <screenshot>
      <caption>Extra features you can switch on, each with a plain-language description</caption>
      <image type="source" width="1200" height="900">https://raw.githubusercontent.com/blyatiful1/gtheme/main/docs/media/screenshots/addons-light.png</image>
    </screenshot>
    <screenshot>
      <caption>Every change is saved first, so you can go back to any earlier day</caption>
      <image type="source" width="1200" height="900">https://raw.githubusercontent.com/blyatiful1/gtheme/main/docs/media/screenshots/restore-light.png</image>
    </screenshot>
    <screenshot>
      <caption>The same window in dark</caption>
      <image type="source" width="1200" height="900">https://raw.githubusercontent.com/blyatiful1/gtheme/main/docs/media/screenshots/home-dark.png</image>
    </screenshot>
  </screenshots>

  <url type="homepage">https://github.com/blyatiful1/gtheme</url>
  <url type="bugtracker">https://github.com/blyatiful1/gtheme/issues</url>
  <url type="help">https://github.com/blyatiful1/gtheme/blob/main/docs/start-here.md</url>
  <url type="vcs-browser">https://github.com/blyatiful1/gtheme</url>

  <developer id="io.github.blyatiful1">
    <name>blyatiful1</name>
  </developer>

  <branding>
    <color type="primary" scheme_preference="light">#c8b6f4</color>
    <color type="primary" scheme_preference="dark">#3b2a6b</color>
  </branding>

  <content_rating type="oars-1.1"/>

  <recommends>
    <control>pointing</control>
    <control>keyboard</control>
  </recommends>
  <requires>
    <display_length compare="ge">768</display_length>
  </requires>

  <releases>
    <!-- This version must equal `__version__` in src/gtheme/__init__.py and
         `pkgver` in PKGBUILD. It stays type="development" until the matching
         v2.0.0 git tag is cut. -->
    <release version="2.0.0" type="development" date="2026-08-25">
      <description>
        <p>The v2 rebuild: gtheme becomes a graphical app.</p>
      </description>
    </release>
  </releases>
</component>
