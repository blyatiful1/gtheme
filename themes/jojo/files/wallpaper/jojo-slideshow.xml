<?xml version="1.0" encoding="UTF-8"?>
<!-- JoJo Part 6+ (STONE OCEAN theme) GNOME background slideshow
     3 wallpapers x 480 s static, 8 s overlay crossfades, loops forever. -->
<background>
  <starttime>
    <year>2026</year>
    <month>01</month>
    <day>01</day>
    <hour>00</hour>
    <minute>00</minute>
    <second>00</second>
  </starttime>
  <static>
    <duration>480.0</duration>
    <file>/home/crocco/.local/share/backgrounds/jojo/stone-ocean.png</file>
  </static>
  <transition type="overlay">
    <duration>8.0</duration>
    <from>/home/crocco/.local/share/backgrounds/jojo/stone-ocean.png</from>
    <to>/home/crocco/.local/share/backgrounds/jojo/golden-spin.png</to>
  </transition>
  <static>
    <duration>480.0</duration>
    <file>/home/crocco/.local/share/backgrounds/jojo/golden-spin.png</file>
  </static>
  <transition type="overlay">
    <duration>8.0</duration>
    <from>/home/crocco/.local/share/backgrounds/jojo/golden-spin.png</from>
    <to>/home/crocco/.local/share/backgrounds/jojo/soft-and-wet.png</to>
  </transition>
  <static>
    <duration>480.0</duration>
    <file>/home/crocco/.local/share/backgrounds/jojo/soft-and-wet.png</file>
  </static>
  <transition type="overlay">
    <duration>8.0</duration>
    <from>/home/crocco/.local/share/backgrounds/jojo/soft-and-wet.png</from>
    <to>/home/crocco/.local/share/backgrounds/jojo/stone-ocean.png</to>
  </transition>
</background>
