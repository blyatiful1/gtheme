<?xml version="1.0" encoding="UTF-8"?>
<!-- NETRUNNER GNOME background: a single still of Night City from the
     bluff — the graceful-degrade backdrop behind Hanabi's live loop.
     One frame, held forever; the motion is Hanabi's job. -->
<background>
  <starttime>
    <year>2026</year>
    <month>01</month>
    <day>01</day>
    <hour>00</hour>
    <minute>00</minute>
    <second>00</second>
  </starttime>
  <static>
    <duration>86400.0</duration>
    <file>{{ home }}/.local/share/backgrounds/netrunner/netrunner-still.png</file>
  </static>
</background>
