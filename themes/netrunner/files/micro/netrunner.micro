# NETRUNNER — Jack In — generated by gtheme micro colorscheme.

color-link default "#D8E7F0,#0A111F"
color-link comment "italic #5F7396"
color-link ignore "#5F7396"

color-link identifier "#D8E7F0"
color-link identifier.class "#4D9EF0"
color-link identifier.var "#D8E7F0"

color-link constant "#EFDF33"
color-link constant.number "#FCEE0A"
color-link constant.string "#2BE8A8"

color-link symbol "#10C8D8"
color-link symbol.operator "#10C8D8"
color-link symbol.brackets "#9AACC0"
color-link symbol.tag "#FF7088"

color-link type "#4D9EF0"
color-link type.keyword "#EE4BA5"
color-link type.extended "default"

color-link special "#EE4BA5"
color-link statement "#EE4BA5"
color-link preproc "#26D5E5"

color-link underlined "underline #26D5E5"
color-link error "bold #FF7088"
color-link todo "bold #FCEE0A"

color-link diff-added "#2BE8A8"
color-link diff-modified "#EFDF33"
color-link diff-deleted "#FF3D5E"

color-link gutter-error "#FF7088"
color-link gutter-warning "#FCEE0A"

color-link statusline "#D8E7F0,#19243A"
color-link tabbar "#D8E7F0,#19243A"
color-link indent-char "#19243A"
color-link line-number "#5F7396,#0A111F"
color-link current-line-number "#10C8D8,#0A111F"

color-link cursor-line "#111A2C"
color-link color-column "#111A2C"
color-link match-brace "#0A111F,#EFDF33"
color-link selection "#D8E7F0,#14324A"
color-link hlsearch "#0A111F,#EFDF33"

color-link divider "#19243A"
color-link scrollbar "#5F7396"
color-link message "#D8E7F0,#0A111F"
color-link error-message "bold #FF7088,#0A111F"
