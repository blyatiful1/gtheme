# NETRUNNER — cava audio visualizer.
# Bars run cyan to hot-pink, the terminal's second vein. Transparent
# background — the glass terminal shows through.

[general]
framerate = 60
bars = 0
bar_width = 2
bar_spacing = 1
sleep_timer = 3

[output]
method = ncurses
channels = stereo

[color]
# cyan (bottom) -> hot pink (top)
gradient = 1
gradient_color_1 = '#00F0FF'
gradient_color_2 = '#FF2E97'

[smoothing]
noise_reduction = 77
monstercat = 1
waves = 0
