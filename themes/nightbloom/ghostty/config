# ── NIGHTBLOOM — Ghostty ────────────────────────────────────────────
# The glasshouse after dark: glass panes, bioluminescent jade,
# one firefly (the cursor). Managed at ~/nightbloom/ghostty.

theme = nightbloom

# ── Type: Monaspace, texture healing on, Radon handwriting italics ──
font-family = Monaspace Argon
font-family = Symbols Nerd Font Mono
font-family-italic = Monaspace Radon
font-family-bold-italic = Monaspace Radon
font-size = 11
font-feature = calt
font-feature = liga
font-feature = ss01
font-feature = ss02
font-feature = ss03
font-feature = ss07
font-feature = ss08

# ── Glass ───────────────────────────────────────────────────────────
# Real blur comes from blur-my-shell (Applications → com.mitchellh.ghostty).
# Ghostty's own background-blur is KDE-protocol only — inert on GNOME. On
# GNOME 51 + Ghostty 1.4 this becomes: background-blur = true, bms entry off.
background-opacity = 0.82
unfocused-split-opacity = 0.85
window-padding-x = 12
window-padding-y = 10
window-padding-balance = true
window-padding-color = extend

# ── Chrome: calm, no titlebar slab ──────────────────────────────────
gtk-titlebar = false
gtk-titlebar-hide-when-maximized = true
window-decoration = auto
gtk-custom-css = nightbloom.css
window-theme = ghostty

# ── The firefly ─────────────────────────────────────────────────────
cursor-style = block
cursor-style-blink = false
custom-shader = shaders/nightbloom_firefly.glsl
custom-shader = shaders/nightbloom_fog.glsl
custom-shader-animation = true
mouse-hide-while-typing = true

# ── Behavior ────────────────────────────────────────────────────────
shell-integration = fish
shell-integration-features = cursor,sudo,title
scrollback-limit = 10000000
link-url = true
copy-on-select = clipboard
confirm-close-surface = false
window-inherit-working-directory = true

# splits
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+e=new_split:down
keybind = ctrl+shift+w=close_surface
