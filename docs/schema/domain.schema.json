    "RequireFirst": {
      "additionalProperties": false,
      "description": "A key that must be written first for this row to have any effect.\n\nGNOME has several settings that are silently inert until a *different* key\nis set. Writing the visible one alone produces a control that appears to\nwork and does nothing, which is the worst failure mode a novice app can\nhave. The known cases:\n\n* font hinting and antialiasing do nothing while\n  ``interface font-rendering`` is ``'automatic'``,\n* the titlebar font does nothing while\n  ``wm.preferences titlebar-uses-system-font`` is true,\n* a fixed workspace count does nothing while ``mutter dynamic-workspaces``\n  is true.",
      "properties": {
        "explain": {
          "title": "Explain",
          "type": "string"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "schema_id": {
          "title": "Schema Id",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "schema_id",
        "key",
        "value",
        "explain"
      ],
      "title": "RequireFirst",
      "type": "object"
    },
