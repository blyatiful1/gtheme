# {{ title }} — generated by gtheme from palette.toml. Edit the palette, not this file.

[colors.primary]
background      = "{{ bg }}"
foreground      = "{{ fg }}"
dim_foreground  = "{{ fg_dim }}"
bright_foreground = "{{ fg_bright }}"

[colors.cursor]
text   = "{{ bg }}"
cursor = "{{ cursor }}"

[colors.selection]
text       = "{{ fg }}"
background = "{{ selection }}"

[colors.normal]
black   = "{{ ansi_black }}"
red     = "{{ red }}"
green   = "{{ green }}"
yellow  = "{{ yellow }}"
blue    = "{{ blue }}"
magenta = "{{ magenta }}"
cyan    = "{{ cyan }}"
white   = "{{ ansi_white }}"

[colors.bright]
black   = "{{ bright_black }}"
red     = "{{ bright_red }}"
green   = "{{ bright_green }}"
yellow  = "{{ bright_yellow }}"
blue    = "{{ bright_blue }}"
magenta = "{{ bright_magenta }}"
cyan    = "{{ bright_cyan }}"
white   = "{{ bright_white }}"
