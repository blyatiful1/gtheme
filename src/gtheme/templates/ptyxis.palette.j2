# {{ title }} — generated by gtheme from palette.toml.

[Palette]
Name={{ Name }}

[Dark]
Foreground={{ fg }}
Background={{ bg }}
Cursor={{ cursor }}
CursorForeground={{ bg }}
TitlebarBackground={{ surface1 }}
TitlebarForeground={{ fg }}
BellBackground={{ warn|default(yellow) }}
BellForeground={{ bg }}
SuperuserBackground={{ accent }}
SuperuserForeground={{ fg_bright }}
RemoteBackground={{ surface2 }}
RemoteForeground={{ fg }}
Color0={{ ansi_black }}
Color1={{ red }}
Color2={{ green }}
Color3={{ yellow }}
Color4={{ blue }}
Color5={{ magenta }}
Color6={{ cyan }}
Color7={{ ansi_white }}
Color8={{ bright_black }}
Color9={{ bright_red }}
Color10={{ bright_green }}
Color11={{ bright_yellow }}
Color12={{ bright_blue }}
Color13={{ bright_magenta }}
Color14={{ bright_cyan }}
Color15={{ bright_white }}

[Light]
Foreground={{ bg }}
Background={{ fg_bright }}
Cursor={{ accent }}
CursorForeground={{ fg_bright }}
TitlebarBackground={{ fg }}
TitlebarForeground={{ bg }}
BellBackground={{ warn|default(yellow) }}
BellForeground={{ fg_bright }}
SuperuserBackground={{ accent }}
SuperuserForeground={{ fg_bright }}
RemoteBackground={{ fg }}
RemoteForeground={{ bg }}
Color0={{ ansi_black }}
Color1={{ red|darken(10) }}
Color2={{ green|darken(15) }}
Color3={{ yellow|darken(15) }}
Color4={{ blue|darken(15) }}
Color5={{ magenta|darken(15) }}
Color6={{ cyan|darken(15) }}
Color7={{ ansi_white }}
Color8={{ bright_black }}
Color9={{ red }}
Color10={{ green }}
Color11={{ yellow }}
Color12={{ blue }}
Color13={{ magenta }}
Color14={{ cyan }}
Color15=#FFFFFF
