# {{ title }} — generated by gtheme micro colorscheme.

color-link default "{{ fg }},{{ bg }}"
color-link comment "italic {{ comment }}"
color-link ignore "{{ comment }}"

color-link identifier "{{ fg }}"
color-link identifier.class "{{ blue }}"
color-link identifier.var "{{ fg }}"

color-link constant "{{ yellow }}"
color-link constant.number "{{ bright_yellow }}"
color-link constant.string "{{ green }}"

color-link symbol "{{ accent }}"
color-link symbol.operator "{{ accent }}"
color-link symbol.brackets "{{ fg_dim }}"
color-link symbol.tag "{{ bright_red }}"

color-link type "{{ blue }}"
color-link type.keyword "{{ magenta }}"
color-link type.extended "default"

color-link special "{{ magenta }}"
color-link statement "{{ magenta }}"
color-link preproc "{{ cyan }}"

color-link underlined "underline {{ cyan }}"
color-link error "bold {{ bright_red }}"
color-link todo "bold {{ bright_yellow }}"

color-link diff-added "{{ green }}"
color-link diff-modified "{{ yellow }}"
color-link diff-deleted "{{ red }}"

color-link gutter-error "{{ bright_red }}"
color-link gutter-warning "{{ bright_yellow }}"

color-link statusline "{{ fg }},{{ surface2 }}"
color-link tabbar "{{ fg }},{{ surface2 }}"
color-link indent-char "{{ surface2 }}"
color-link line-number "{{ comment }},{{ bg }}"
color-link current-line-number "{{ accent }},{{ bg }}"

color-link cursor-line "{{ surface1 }}"
color-link color-column "{{ surface1 }}"
color-link match-brace "{{ bg }},{{ warn|default(yellow) }}"
color-link selection "{{ fg }},{{ selection }}"
color-link hlsearch "{{ bg }},{{ warn|default(yellow) }}"

color-link divider "{{ surface2 }}"
color-link scrollbar "{{ comment }}"
color-link message "{{ fg }},{{ bg }}"
color-link error-message "bold {{ bright_red }},{{ bg }}"
