# {{ title }} — generated by gtheme btop theme.

theme[main_bg]="{{ bg }}"
theme[main_fg]="{{ fg }}"
theme[title]="{{ fg_bright }}"
theme[hi_fg]="{{ accent }}"
theme[selected_bg]="{{ selection }}"
theme[selected_fg]="{{ fg_bright }}"
theme[inactive_fg]="{{ comment }}"
theme[graph_text]="{{ fg_dim }}"
theme[meter_bg]="{{ surface2 }}"
theme[proc_misc]="{{ accent_bright }}"

theme[cpu_box]="{{ surface2 }}"
theme[mem_box]="{{ surface2 }}"
theme[net_box]="{{ surface2 }}"
theme[proc_box]="{{ surface2 }}"
theme[div_line]="{{ surface2 }}"

theme[temp_start]="{{ green }}"
theme[temp_mid]="{{ yellow }}"
theme[temp_end]="{{ red }}"

theme[cpu_start]="{{ info|default(blue) }}"
theme[cpu_mid]="{{ warn|default(yellow) }}"
theme[cpu_end]="{{ error|default(red) }}"

theme[free_start]="{{ green }}"
theme[free_mid]="{{ green|darken(20) }}"
theme[free_end]="{{ green|darken(40) }}"

theme[cached_start]="{{ blue }}"
theme[cached_mid]="{{ blue|darken(20) }}"
theme[cached_end]="{{ blue|darken(40) }}"

theme[available_start]="{{ cyan }}"
theme[available_mid]="{{ cyan|darken(20) }}"
theme[available_end]="{{ cyan|darken(40) }}"

theme[used_start]="{{ green }}"
theme[used_mid]="{{ yellow }}"
theme[used_end]="{{ red }}"

theme[download_start]="{{ accent }}"
theme[download_mid]="{{ accent|mix(cyan, 0.5) }}"
theme[download_end]="{{ cyan }}"

theme[upload_start]="{{ magenta }}"
theme[upload_mid]="{{ magenta|mix(red, 0.5) }}"
theme[upload_end]="{{ red }}"

theme[process_start]="{{ info|default(blue) }}"
theme[process_mid]="{{ accent }}"
theme[process_end]="{{ accent_bright }}"
